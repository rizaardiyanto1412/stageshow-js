{
  "name": "stageshow-js",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "description": "Stageshow without a framework: faux product UI and cursor demos that export as one block of HTML, CSS and JS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizaardiyanto1412/stageshow-js.git"
  },
  "keywords": [
    "stageshow",
    "product-demo",
    "faux-ui",
    "animation",
    "cursor",
    "skill",
    "agent"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": "./kit/index.ts",
    "./export": "./scripts/export.mjs",
    "./jsx-runtime": "./kit/jsx-runtime.ts",
    "./jsx-dev-runtime": "./kit/jsx-dev-runtime.ts",
    "./*": "./kit/*"
  },
  "bin": {
    "stageshow-export": "scripts/export.mjs"
  },
  "files": [
    "kit",
    "scripts",
    "playground",
    "examples",
    "teaching",
    "references",
    "SKILL.md",
    "NOTICE.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p playground",
    "build": "vite build playground --config playground/vite.config.ts",
    "check:css": "node scripts/class-clash.mjs --bundle teaching --bundle examples/looks examples teaching",
    "export": "node scripts/export.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "lucide": "0.468.0",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "~1.48.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  },
  "optionalDependencies": {
    "portless": "^0.4.1"
  }
}
