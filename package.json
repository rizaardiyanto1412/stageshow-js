{
  "name": "stageshow-js",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "description": "Stageshow without a framework: faux product UI and cursor demos that export as one block of HTML, CSS and JS.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p playground",
    "build": "vite build playground --config playground/vite.config.ts",
    "check:css": "node scripts/class-clash.mjs --bundle teaching --bundle examples/looks examples teaching",
    "export": "node scripts/export.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "lucide": "0.468.0",
    "morphdom": "^2.7.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "playwright-core": "~1.48.2",
    "postcss": "^8.5.6",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  },
  "optionalDependencies": {
    "portless": "^0.4.1"
  }
}
